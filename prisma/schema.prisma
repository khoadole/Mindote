datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String       @id @db.Uuid  // Sync với auth.users.id của Supabase
  email       String       @unique
  username    String?
  displayName String?      @map("display_name")
  avatarUrl   String?      @map("avatar_url")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  
  collections Collection[]
  setting     Setting?

  @@index([email])
  @@map("users")
}

model Collection {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  name      String
  color     String
  createdAt DateTime @default(now()) @map("created_at")
  words     Word[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("collections")
}

model Word {
  id           String     @id @default(uuid()) @db.Uuid
  term         String
  definition   String
  example      String?
  phonetic     String?
  score        Int        @default(0)
  createdAt    DateTime   @default(now()) @map("created_at")
  collectionId String     @db.Uuid @map("collection_id")
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId, term])
  @@unique([collectionId, term])
  @@map("words")
}

model Setting {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid @map("user_id")
  srsEnabled Boolean  @default(false) @map("srs_enabled")
  ttsEnabled Boolean  @default(false) @map("tts_enabled")
  theme      String   @default("dark")
  language   String   @default("en")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}
