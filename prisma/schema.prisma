generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @db.Uuid
  email         String         @unique
  username      String?
  displayName   String?        @map("display_name")
  avatarUrl     String?        @map("avatar_url")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  currentStreak Int            @default(0) @map("current_streak")
  lastLoginDate DateTime?      @map("last_login_date")
  lastLearningDate DateTime?   @map("last_learning_date")
  longestStreak Int            @default(0) @map("longest_streak")
  collections     Collection[]
  setting         Setting?
  subscriptions   Subscription[]
  payosOrders     PayOSOrder[]
  aiLogs          AILog[]
  aiUsages        AIUsage[]
  cefrProgress    CEFRWordProgress[]
  writingAttempts WritingAttempt[]
  chatSessions    ChatSession[]
  chatUsages      ChatUsage[]
  dailyActivity   UserDailyActivity[]

  @@index([email])
  @@map("users")
}

model Collection {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  name            String
  color           String
  icon            String           @default("Layers")
  createdAt       DateTime         @default(now()) @map("created_at")
  difficultyLevel String?          @map("difficulty_level")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  readingPassages ReadingPassage[]
  words           Word[]

  @@index([userId])
  @@index([createdAt], map: "idx_collections_created_at_brin", type: Brin)
  @@map("collections")
}


model Word {
  id                 String     @id @default(uuid()) @db.Uuid
  term               String
  definition         String
  example            String?
  phonetic           String?
  score              Int        @default(0)
  createdAt          DateTime   @default(now()) @map("created_at")
  collectionId       String     @map("collection_id") @db.Uuid
  easeFactor         Float      @default(2.5) @map("ease_factor")
  interval           Int        @default(0)
  lastReviewed       DateTime?  @map("last_reviewed")
  nextReview         DateTime?  @map("next_review")
  partOfSpeech       String?    @map("part_of_speech")
  repetitions        Int        @default(0)
  definitionLanguage String     @default("en") @map("definition_language")
  exampleLanguage    String     @default("en") @map("example_language")
  termLanguage       String     @default("en") @map("term_language")
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  collection         Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, term])
  @@index([collectionId, term])
  @@index([collectionId, score])
  @@index([nextReview])
  @@index([collectionId, nextReview])
  @@index([termLanguage])
  @@index([createdAt], map: "idx_words_created_at_brin", type: Brin)
  @@index([definition(ops: raw("gin_trgm_ops"))], map: "idx_words_definition_gin", type: Gin)
  @@index([term(ops: raw("gin_trgm_ops"))], map: "idx_words_term_gin", type: Gin)
  @@map("words")
}

model Setting {
  userId           String   @id @map("user_id") @db.Uuid
  theme            String   @default("dark")
  language         String   @default("en")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  learningLanguage String   @default("en") @map("learning_language")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model ReadingPassage {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  collectionId  String           @map("collection_id") @db.Uuid
  title         String
  content       String
  level         String
  wordCount     Int              @map("word_count")
  estimatedTime Int              @map("estimated_time")
  wordsUsed     String[]         @map("words_used")
  questions     Json
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  attempts      ReadingAttempt[]
  collection    Collection       @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([userId, collectionId])
  @@index([level])
  @@index([createdAt])
  @@index([content(ops: raw("gin_trgm_ops"))], map: "idx_reading_passages_content_gin", type: Gin)
  @@index([createdAt], map: "idx_reading_passages_created_at_brin", type: Brin)
  @@index([title(ops: raw("gin_trgm_ops"))], map: "idx_reading_passages_title_gin", type: Gin)
  @@map("reading_passages")
}

model ReadingAttempt {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  passageId   String         @map("passage_id") @db.Uuid
  timeSpent   Int            @map("time_spent")
  score       Int
  answers     Json
  completedAt DateTime       @default(now()) @map("completed_at")
  passage     ReadingPassage @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@index([userId, passageId])
  @@index([userId, completedAt])
  @@index([completedAt], map: "idx_reading_attempts_completed_at_brin", type: Brin)
  @@map("reading_attempts")
}

model Plan {
  id                 String         @id @default(uuid()) @db.Uuid
  productId          Int            @map("product_id")
  productName        String?        @map("product_name")
  variantId          Int            @unique @map("variant_id")
  name               String
  description        String?
  price              String
  isUsageBased       Boolean        @default(false) @map("is_usage_based")
  interval           String?
  intervalCount      Int?           @map("interval_count")
  trialInterval      String?        @map("trial_interval")
  trialIntervalCount Int?           @map("trial_interval_count")
  sort               Int?
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  subscriptions      Subscription[]

  @@index([variantId])
  @@map("plans")
}

model Subscription {
  id                 String   @id @default(uuid()) @db.Uuid
  provider           String   @default("lemonsqueezy") // "lemonsqueezy" | "payos"
  lemonSqueezyId     String?  @unique @map("lemon_squeezy_id")
  payosOrderCode     String?  @unique @map("payos_order_code")
  orderId            Int?     @map("order_id")
  name               String
  email              String
  status             String
  statusFormatted    String   @map("status_formatted")
  startsAt           String?  @map("starts_at")
  renewsAt           String?  @map("renews_at")
  endsAt             String?  @map("ends_at")
  trialEndsAt        String?  @map("trial_ends_at")
  price              String
  isUsageBased       Boolean  @default(false) @map("is_usage_based")
  isPaused           Boolean  @default(false) @map("is_paused")
  subscriptionItemId Int?     @map("subscription_item_id")
  userId             String   @map("user_id") @db.Uuid
  planId             String   @map("plan_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  plan               Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lemonSqueezyId])
  @@index([status])
  @@index([provider])
  @@map("subscriptions")
}

model WebhookEvent {
  id              String   @id @default(uuid()) @db.Uuid
  eventName       String   @map("event_name")
  processed       Boolean  @default(false)
  body            Json
  processingError String?  @map("processing_error")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([eventName])
  @@index([processed])
  @@map("webhook_events")
}

// Tracks each PayOS payment intent from creation to completion
model PayOSOrder {
  id              String   @id @default(uuid()) @db.Uuid
  orderCode       String   @unique @map("order_code")
  userId          String   @map("user_id") @db.Uuid
  planType        String   @map("plan_type") // "monthly" | "yearly"
  amount          Int      // amount in VND
  status          String   @default("PENDING") // PENDING | PAID | CANCELLED | EXPIRED
  paymentLinkId   String?  @map("payment_link_id")
  checkoutUrl     String?  @map("checkout_url")
  webhookData     Json?    @map("webhook_data")
  processingError String?  @map("processing_error")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderCode])
  @@index([status])
  @@map("payos_orders")
}

model AILog {
  userId       String   @map("user_id") @db.Uuid
  feature      String
  model        String
  inputTokens  Int      @map("input_tokens")
  outputTokens Int      @map("output_tokens")
  totalTokens  Int      @map("total_tokens")
  cost         Float
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, feature])
  @@index([createdAt])
  @@map("ai_logs")
}

model AIUsage {
  userId String   @map("user_id") @db.Uuid
  date   DateTime @db.Date
  count  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
  @@map("ai_usages")
}

// ============================================
// CEFR VOCABULARY TABLES (Static Reference Data)
// ============================================

model CEFRTopic {
  id        String     @id @default(uuid()) @db.Uuid
  level     String     // A1, A2, B1, B2, C1, C2
  order     Int        // topic_order từ CSV
  name      String     // topic name
  isFree    Boolean    @default(false) @map("is_free")
  createdAt DateTime   @default(now()) @map("created_at")

  words     CEFRWord[]

  @@unique([level, name])
  @@index([level])
  @@index([order])
  @@map("cefr_topics")
}

model CEFRWord {
  id         String    @id @default(uuid()) @db.Uuid
  topicId    String    @map("topic_id") @db.Uuid
  order      Int       // temp_order từ CSV (thứ tự trong topic)
  term       String    // temp (từ vựng)
  pos        String    // part of speech
  phonetic   String    // IPA phonetic
  definition String    // định nghĩa
  example    String    // câu ví dụ
  createdAt  DateTime  @default(now()) @map("created_at")

  topic      CEFRTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  learnedBy  CEFRWordProgress[]

  @@unique([topicId, order])
  @@index([topicId])
  @@index([term])
  @@map("cefr_words")
}

// Track user's learning progress for CEFR words
model CEFRWordProgress {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  wordId    String   @map("word_id") @db.Uuid
  learned   Boolean  @default(true)
  learnedAt DateTime @default(now()) @map("learned_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  word      CEFRWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId])
  @@index([wordId])
  @@map("cefr_word_progress")
}

// ============================================
// WRITING PRACTICE TABLES
// ============================================

// Pre-curated writing passages managed by admin
model WritingPassage {
  id               String           @id @default(uuid()) @db.Uuid
  title            String                            // Vietnamese title shown to user
  titleEn          String?          @map("title_en") // English reference title (admin use)
  sourceText       String           @map("source_text")   // The Vietnamese prompt
  referenceText    String?          @map("reference_text") // Sample English answer (always shown)
  level            String                            // "A1"|"A2"|"B1"|"B2"|"C1"|"C2"
  topic            String                            // e.g., "Travel", "Environment"
  tags             String[]
  targetWordCount  Int              @default(100) @map("target_word_count")
  estimatedMinutes Int              @default(10)  @map("estimated_minutes")
  isPublished      Boolean          @default(true) @map("is_published")
  order            Int              @default(0)
  vocabularyHints  Json?            @map("vocabulary_hints") // future: [{word, definition}]
  grammarFocus     String?          @map("grammar_focus")    // future: "Past Perfect"
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  attempts         WritingAttempt[]

  @@index([level])
  @@index([topic])
  @@index([isPublished, level])
  @@map("writing_passages")
}

// User's writing attempts — keep last 3 per (userId, passageId) via app logic
model WritingAttempt {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  passageId   String         @map("passage_id") @db.Uuid
  userText    String         @map("user_text")
  aiResult    Json?          @map("ai_result")
  score       Float?                               // aiResult.overallScore for quick sorting
  completedAt DateTime       @default(now()) @map("completed_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  passage WritingPassage @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@index([userId, passageId])
  @@index([userId, completedAt])
  @@map("writing_attempts")
}

// ============================================
// ACTIVITY TRACKING TABLES
// ============================================

model UserDailyActivity {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  activityDate          DateTime  @map("activity_date") @db.Date
  
  // Timestamps tracking first and last activity
  firstActivityAt       DateTime  @default(now()) @map("first_activity_at")
  lastActivityAt        DateTime  @default(now()) @updatedAt @map("last_activity_at")
  
  // Activity counters by type
  reviewCount           Int       @default(0) @map("review_count")
  readingAttemptCount   Int       @default(0) @map("reading_attempt_count")
  writingAttemptCount   Int       @default(0) @map("writing_attempt_count")
  cefrLearnCount        Int       @default(0) @map("cefr_learn_count")
  wordCreatedCount      Int       @default(0) @map("word_created_count")
  
  totalEvents           Int       @default(1) @map("total_events")
  
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")
  
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, activityDate])
  @@index([userId, activityDate(sort: Desc)])
  @@index([activityDate(sort: Desc)])
  @@map("user_daily_activity")
}

// ============================================
// CHATBOT TABLES
// ============================================

model ChatSession {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  title     String
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  messages  ChatMessage[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @map("session_id") @db.Uuid
  role      String      // "user" | "assistant"
  content   String
  createdAt DateTime    @default(now()) @map("created_at")
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model ChatUsage {
  userId String   @map("user_id") @db.Uuid
  date   DateTime @db.Date
  count  Int      @default(0)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
  @@map("chat_usages")
}
