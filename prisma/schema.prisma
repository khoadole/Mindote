generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String       @id @db.Uuid
  email       String       @unique
  username    String?
  displayName String?      @map("display_name")
  avatarUrl   String?      @map("avatar_url")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  collections Collection[]
  setting     Setting?

  @@index([email])
  @@map("users")
}

model Collection {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  color     String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  words     Word[]

  @@index([userId])
  @@map("collections")
}

model Word {
  id           String     @id @default(uuid()) @db.Uuid
  term         String
  definition   String
  example      String?
  phonetic     String?
  partOfSpeech String?    @map("part_of_speech")               // Parts of speech (noun, verb, etc.)
  score        Int        @default(0)
  createdAt    DateTime   @default(now()) @map("created_at")
  collectionId String     @map("collection_id") @db.Uuid
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  
  // Spaced Repetition System (SRS) fields
  easeFactor   Float      @default(2.5) @map("ease_factor")     // SM-2 ease factor (quality of memory)
  interval     Int        @default(0)                           // Days until next review
  repetitions  Int        @default(0)                           // Number of successful reviews
  lastReviewed DateTime?  @map("last_reviewed")                // Last review date
  nextReview   DateTime?  @map("next_review")                  // Next review due date
  
  @@unique([collectionId, term])
  @@index([collectionId, term])
  @@index([collectionId, score])
  @@index([nextReview])
  @@map("words")
}

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  theme     String   @default("dark")
  language  String   @default("en")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model YouTubeHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  url       String
  title     String
  videoId   String   @map("video_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, videoId])  // 1 user không duplicate cùng video
  @@index([userId, createdAt]) // Query history nhanh
  @@index([videoId])           // Lookup by videoId
  @@map("youtube_history")
}

model AIUsage {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @default(now()) @db.Date  // Only store date, not time
  count     Int      @default(0)               // Number of AI calls on this date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, date])        // One record per user per day
  @@index([userId, date])         // Fast lookup for daily quota check
  @@map("ai_usage")
}
