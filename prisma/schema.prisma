generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String         @id @db.Uuid
  email           String         @unique
  username        String?
  displayName     String?        @map("display_name")
  avatarUrl       String?        @map("avatar_url")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  lastLoginDate   DateTime?      @map("last_login_date")
  currentStreak   Int            @default(0) @map("current_streak")
  longestStreak   Int            @default(0) @map("longest_streak")
  collections     Collection[]
  setting         Setting?
  subscriptions   Subscription[]

  @@index([email])
  @@map("users")
}

model Collection {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  name            String
  color           String
  createdAt       DateTime         @default(now()) @map("created_at")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  words           Word[]
  readingPassages ReadingPassage[]

  @@index([userId])
  @@map("collections")
}

model Word {
  id           String     @id @default(uuid()) @db.Uuid
  term         String
  definition   String
  example      String?
  phonetic     String?
  partOfSpeech String?    @map("part_of_speech")               // Parts of speech (noun, verb, etc.)
  score        Int        @default(0)
  createdAt    DateTime   @default(now()) @map("created_at")
  collectionId String     @map("collection_id") @db.Uuid
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  
  // Spaced Repetition System (SRS) fields
  easeFactor   Float      @default(2.5) @map("ease_factor")     // SM-2 ease factor (quality of memory)
  interval     Int        @default(0)                           // Days until next review
  repetitions  Int        @default(0)                           // Number of successful reviews
  lastReviewed DateTime?  @map("last_reviewed")                // Last review date
  nextReview   DateTime?  @map("next_review")                  // Next review due date
  
  @@unique([collectionId, term])
  @@index([collectionId, term])
  @@index([collectionId, score])
  @@index([nextReview])
  @@index([collectionId, nextReview])
  @@map("words")
}

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  theme     String   @default("dark")
  language  String   @default("en")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model YouTubeHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  url       String
  title     String
  videoId   String   @map("video_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, videoId])  // 1 user không duplicate cùng video
  @@index([userId, createdAt]) // Query history nhanh
  @@index([videoId])           // Lookup by videoId
  @@map("youtube_history")
}

model AIUsage {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @default(now()) @db.Date  // Only store date, not time
  count     Int      @default(0)               // Number of AI calls on this date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, date])        // One record per user per day
  @@index([userId, date])         // Fast lookup for daily quota check
  @@map("ai_usage")
}

model ReadingPassage {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  collectionId  String   @map("collection_id") @db.Uuid
  title         String
  content       String   @db.Text
  level         String   // "A1", "A2", "B1", "B2", "C1", "C2"
  wordCount     Int      @map("word_count")
  estimatedTime Int      @map("estimated_time") // Reading time in minutes
  wordsUsed     String[] @map("words_used")     // Array of terms from collection
  questions     Json                            // Array of comprehension questions
  createdAt     DateTime @default(now()) @map("created_at")
  
  collection    Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  attempts      ReadingAttempt[]
  
  @@index([userId, collectionId])
  @@index([level])
  @@index([createdAt])
  @@map("reading_passages")
}

model ReadingAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  passageId   String   @map("passage_id") @db.Uuid
  timeSpent   Int      @map("time_spent")    // Seconds
  score       Int                            // Percentage (0-100)
  answers     Json                           // User's answers
  completedAt DateTime @default(now()) @map("completed_at")
  
  passage     ReadingPassage @relation(fields: [passageId], references: [id], onDelete: Cascade)
  
  @@index([userId, passageId])
  @@index([userId, completedAt])
  @@map("reading_attempts")
}

// ============================================
// LEMON SQUEEZY BILLING MODELS
// ============================================

model Plan {
  id                 String         @id @default(uuid()) @db.Uuid
  productId          Int            @map("product_id")
  productName        String?        @map("product_name")
  variantId          Int            @unique @map("variant_id")
  name               String
  description        String?
  price              String
  isUsageBased       Boolean        @default(false) @map("is_usage_based")
  interval           String?        // "month", "year"
  intervalCount      Int?           @map("interval_count")
  trialInterval      String?        @map("trial_interval")
  trialIntervalCount Int?           @map("trial_interval_count")
  sort               Int?
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  subscriptions      Subscription[]

  @@index([variantId])
  @@map("plans")
}

model Subscription {
  id                 String   @id @default(uuid()) @db.Uuid
  lemonSqueezyId     String   @unique @map("lemon_squeezy_id") // Subscription ID from Lemon Squeezy
  orderId            Int      @map("order_id")
  name               String
  email              String
  status             String   // "on_trial", "active", "paused", "past_due", "unpaid", "cancelled", "expired"
  statusFormatted    String   @map("status_formatted")
  renewsAt           String?  @map("renews_at")
  endsAt             String?  @map("ends_at")
  trialEndsAt        String?  @map("trial_ends_at")
  price              String
  isUsageBased       Boolean  @default(false) @map("is_usage_based")
  isPaused           Boolean  @default(false) @map("is_paused")
  subscriptionItemId Int?     @map("subscription_item_id")
  userId             String   @map("user_id") @db.Uuid
  planId             String   @map("plan_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lemonSqueezyId])
  @@index([status])
  @@map("subscriptions")
}

model WebhookEvent {
  id              String   @id @default(uuid()) @db.Uuid
  eventName       String   @map("event_name")
  processed       Boolean  @default(false)
  body            Json
  processingError String?  @map("processing_error")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([eventName])
  @@index([processed])
  @@map("webhook_events")
}
